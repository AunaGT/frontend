{
  "headers": [
    {"source":"/q/:path*","headers":[{"key":"Referrer-Policy","value":"no-referrer"}]},
    {"source":"/p/:path*","headers":[{"key":"Referrer-Policy","value":"no-referrer"}]},
    {"source":"/configuracion/paginas-clientes/:path*","headers":[{"key":"Referrer-Policy","value":"no-referrer"}]}
  ],
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://backend-kappa-ruby-17.vercel.app/api/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
